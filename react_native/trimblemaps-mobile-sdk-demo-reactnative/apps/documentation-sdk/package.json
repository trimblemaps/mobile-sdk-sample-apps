{
  "name": "documentation-sdk",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "preandroid": "node scripts/ensure-android-autolinking.js",
    "android": "react-native run-android",
    "ios": "RCT_NEW_ARCH_ENABLED=1 react-native run-ios --scheme TrimbleMapsReactNativeExample",
    "ios:bootstrap": "node ../../scripts/generate-ios-cartfile.js --app=documentation-sdk && carthage bootstrap --platform iOS --use-xcframeworks && node scripts/sync-ios-frameworks.js",
    "ios:check-cartfile": "node ../../scripts/generate-ios-cartfile.js --app=documentation-sdk --check",
    "ios:pod-install": "bundle install && cd ios && RCT_NEW_ARCH_ENABLED=1 bundle exec pod install",
    "ios:setup": "yarn ios:bootstrap && yarn ios:pod-install",
    "start": "react-native start",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/native": "7.2.5",
    "@react-navigation/native-stack": "7.14.5",
    "@trimblemaps/account-react-native": "1.0.0",
    "@trimblemaps/maps-react-native": "1.0.0",
    "@trimblemaps/plugins-react-native": "1.0.0",
    "@trimblemaps/services-react-native": "1.0.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "2.31.1",
    "react-native-reanimated": "4.3.0",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.25.2",
    "react-native-worklets": "0.8.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-export-namespace-from": "7.29.7",
    "@react-native-community/cli": "20.1.3",
    "@react-native-community/cli-platform-android": "20.1.3",
    "@react-native-community/cli-platform-ios": "20.1.3",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@types/geojson": "7946.0.16",
    "@types/react": "19.2.14",
    "react-native-monorepo-config": "0.3.5",
    "typescript": "5.9.3"
  }
}
